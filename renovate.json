{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"schedule:weekly",
		":enablePreCommit"
	],
	"packageRules": [
		{
			"automerge": true,
			"groupName": "patch dependencies",
			"matchUpdateTypes": [
				"patch"
			]
		},
		{
			"commitMessagePrefix": "chore(deps)",
			"matchDepTypes": [
				"project.dependencies"
			],
			"matchManagers": [
				"pep621",
				"poetry"
			]
		},
		{
			"commitMessagePrefix": "chore(deps-dev)",
			"matchDepTypes": [
				"project.optional-dependencies"
			],
			"matchManagers": [
				"pep621",
				"poetry"
			]
		}
	]
}
